# Cloudflare Pages 응답 헤더
# style-src의 sha256 값 = 구글 로그인 버튼 스크립트(GIS)가 넣는 <style> 내용의 해시. 구글이 바꾸면 콘솔에 새 해시가 나오니 그 값으로 교체 (정적 파일에 적용. /api/* 헤더는 functions/api/[[path]].js에서 설정)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://accounts.google.com/gsi/client; frame-src https://accounts.google.com; style-src 'self' https://cdn.jsdelivr.net https://accounts.google.com/gsi/style 'sha256-RU4sU0AaS8IBGZx8XrGt/pa9A5SLA3dQszGeqT5L3Kw='; font-src https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://accounts.google.com/gsi/; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Robots-Tag: noindex
  ! Access-Control-Allow-Origin

# 이미지는 하루 캐시 (CSS/JS/HTML은 Pages 기본값: 매번 변경 여부 확인)
/icons/*
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
# 음식 이미지는 일주일 캐시 (파일 내용이 바뀌면 이름을 바꿔서 넣기)
/food/*
  Cache-Control: public, max-age=604800
/logo*.svg
  Cache-Control: public, max-age=86400
# 관리자 화면은 캐시하지 않음
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
