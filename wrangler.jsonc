  "vars": { "GOOGLE_CLIENT_ID": "535688073435-4ni888cdujb655ujdlo4ofatpfe75bo5.apps.googleusercontent.com" },
  // 급식 인기투표 · 밸런스 게임 · 소셜(프로필·DM·게임 랭킹)이 함께 쓰는 D1 (테이블은 첫 요청 때 자동 생성)
  "d1_databases": [
    { "binding": "DB", "database_name": "svmhs-ground-db", "database_id": "a88ef890-a617-4c02-84d9-f041d394170c" }
